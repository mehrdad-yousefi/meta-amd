From cd3a1cf5a2fe9f9bb4d20857c484b186fe7d9da1 Mon Sep 17 00:00:00 2001
From: Felix Kuehling <Felix.Kuehling@amd.com>
Date: Thu, 5 Jan 2017 16:36:09 -0500
Subject: [PATCH 006/104] drm/amdgpu: Fix userptr memory usage limit

Change-Id: Id16f5ba11ba369089e393a07f6f1558a9270ecdf
Signed-off-by: Felix Kuehling <Felix.Kuehling@amd.com>
---
 drivers/gpu/drm/amd/amdgpu/amdgpu_amdkfd_gpuvm.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_amdkfd_gpuvm.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_amdkfd_gpuvm.c
index 3e1b579..6f02ec7 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_amdkfd_gpuvm.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_amdkfd_gpuvm.c
@@ -143,7 +143,7 @@ static int amdgpu_amdkfd_reserve_system_mem_limit(struct amdgpu_device *adev,
 
 	} else if (domain == AMDGPU_GEM_DOMAIN_CPU) {
 		if ((kfd_mem_limit.system_mem_used + acc_size >
-			kfd_mem_limit.max_system_mem_limit) &&
+			kfd_mem_limit.max_system_mem_limit) ||
 			(kfd_mem_limit.userptr_mem_used + (size + acc_size) >
 			kfd_mem_limit.max_userptr_mem_limit)) {
 			ret = -ENOMEM;
-- 
2.7.4

