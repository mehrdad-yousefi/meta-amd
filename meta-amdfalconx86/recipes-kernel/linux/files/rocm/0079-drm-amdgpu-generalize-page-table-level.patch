-	shadow = vm->page_directory->shadow;
+	shadow = vm->root.bo->shadow;
 
 	/* padding, etc. */
 	ndw = 64;
 
 	/* assume the worst case */
-	ndw += vm->max_pde_used * 6;
+	ndw += vm->root.last_entry_used * 6;
 
 	memset(&params, 0, sizeof(params));
 	params.adev = adev;
 
 #if !defined(CONFIG_HSA_AMD) && !defined(CONFIG_HSA_AMD_MODULE)
-	pd_addr = amdgpu_bo_gpu_offset(vm->page_directory);
+	pd_addr = amdgpu_bo_gpu_offset(vm->root.bo);
 	if (shadow) {
 		r = amdgpu_ttm_bind(&shadow->tbo, &shadow->tbo.mem);
 		if (r)
@@ -696,9 +696,9 @@ int amdgpu_vm_update_page_directory(struct amdgpu_device *adev,
 	 */
 	if (vm->is_vm_update_mode_cpu) {
 		struct amdgpu_sync sync;
-		struct amdgpu_bo *pd = vm->page_directory;
+		struct amdgpu_bo *pd = vm->root.bo;
 
-		r = amdgpu_bo_kmap(vm->page_directory,
+		r = amdgpu_bo_kmap(vm->root.bo,
 			&params.kptr);
 		if (r)
 			dev_warn(adev->dev, "PD table update using CPU failed. Fallback to SDMA\n");
@@ -711,7 +711,7 @@ int amdgpu_vm_update_page_directory(struct amdgpu_device *adev,
 		}
 	}
 	if (r || !vm->is_vm_update_mode_cpu) {
-		pd_addr = amdgpu_bo_gpu_offset(vm->page_directory);
+		pd_addr = amdgpu_bo_gpu_offset(vm->root.bo);
 		if (shadow) {
 			r = amdgpu_ttm_bind(&shadow->tbo, &shadow->tbo.mem);
 			if (r)
@@ -730,8 +730,8 @@ int amdgpu_vm_update_page_directory(struct amdgpu_device *adev,
 	}
 #endif
 	/* walk over the address space and update the page directory */
-	for (pt_idx = 0; pt_idx <= vm->max_pde_used; ++pt_idx) {
-		struct amdgpu_bo *bo = vm->page_tables[pt_idx].bo;
+	for (pt_idx = 0; pt_idx <= vm->root.last_entry_used; ++pt_idx) {
+		struct amdgpu_bo *bo = vm->root.entries[pt_idx].bo;
 		uint64_t pde, pt;
 
 		if (bo == NULL)
@@ -747,10 +747,10 @@ int amdgpu_vm_update_page_directory(struct amdgpu_device *adev,
 		}
 
 		pt = amdgpu_bo_gpu_offset(bo);
-		if (vm->page_tables[pt_idx].addr == pt)
+		if (vm->root.entries[pt_idx].addr == pt)
 			continue;
 
-		vm->page_tables[pt_idx].addr = pt;
+		vm->root.entries[pt_idx].addr = pt;
 
 		pde = pd_addr + pt_idx * 8;
 		if (((last_pde + 8 * count) != pde) ||
@@ -785,7 +785,7 @@ int amdgpu_vm_update_page_directory(struct amdgpu_device *adev,
 	if (count) {
 		uint64_t pt_addr = amdgpu_vm_adjust_mc_addr(adev, last_pt);
 
-		if (vm->page_directory->shadow)
+		if (vm->root.bo->shadow)
 			amdgpu_vm_do_set_ptes(&params, last_shadow, pt_addr,
 					      count, incr, AMDGPU_PTE_VALID);
 
@@ -800,7 +800,7 @@ int amdgpu_vm_update_page_directory(struct amdgpu_device *adev,
 			return 0;
 		}
 		amdgpu_ring_pad_ib(ring, params.ib);
-		amdgpu_sync_resv(adev, &job->sync, vm->page_directory->tbo.resv,
+		amdgpu_sync_resv(adev, &job->sync, vm->root.bo->tbo.resv,
 				 AMDGPU_FENCE_OWNER_VM);
 		if (shadow)
 			amdgpu_sync_resv(adev, &job->sync, shadow->tbo.resv,
@@ -812,7 +812,7 @@ int amdgpu_vm_update_page_directory(struct amdgpu_device *adev,
 		if (r)
 			goto error_free;
 
-		amdgpu_bo_fence(vm->page_directory, fence, true);
+		amdgpu_bo_fence(vm->root.bo, fence, true);
 		fence_put(vm->last_dir_update);
 		vm->last_dir_update = fence_get(fence);
 		fence_put(fence);
@@ -820,7 +820,7 @@ int amdgpu_vm_update_page_directory(struct amdgpu_device *adev,
 	}
 #else
 	} else if (params.kptr) {
-		amdgpu_bo_kunmap(vm->page_directory);
+		amdgpu_bo_kunmap(vm->root.bo);
 	}
 #endif
 
@@ -867,7 +867,7 @@ static void amdgpu_vm_update_ptes(struct amdgpu_pte_update_params *params,
 	/* initialize the variables */
 	addr = start;
 	pt_idx = addr >> amdgpu_vm_block_size;
-	pt = vm->page_tables[pt_idx].bo;
+	pt = vm->root.entries[pt_idx].bo;
 	if (params->shadow) {
 		if (!pt->shadow)
 			return;
@@ -890,7 +890,7 @@ static void amdgpu_vm_update_ptes(struct amdgpu_pte_update_params *params,
 	/* walk over the address space and update the page tables */
 	while (addr < end) {
 		pt_idx = addr >> amdgpu_vm_block_size;
-		pt = vm->page_tables[pt_idx].bo;
+		pt = vm->root.entries[pt_idx].bo;
 		if (params->shadow) {
 			if (!pt->shadow)
 				return;
@@ -1120,7 +1120,7 @@ static int amdgpu_vm_update_ptes_cpu(struct amdgpu_pte_update_params
 		unsigned nptes;
 		uint64_t pe_start;
 
-		pt = vm->page_tables[pt_idx].bo;
+		pt = vm->root.entries[pt_idx].bo;
 		r = amdgpu_bo_kmap(pt, &vm_update_params->kptr);
 		if (r)
 			return r;
@@ -1195,7 +1195,7 @@ static int amdgpu_vm_bo_update_mapping(struct amdgpu_device *adev,
 		struct amdgpu_sync sync;
 
 		amdgpu_sync_create(&sync);
-		r = amdgpu_sync_resv(adev, &sync, vm->page_directory->tbo.resv,
+		r = amdgpu_sync_resv(adev, &sync, vm->root.bo->tbo.resv,
 			owner);
 		if (r) {
 			dev_warn(adev->dev, "CPU pte update failed. Fallback to SDMA\n");
@@ -1283,12 +1283,12 @@ fallback_sdma_update:
 	if (r)
 		goto error_free;
 
-	r = amdgpu_sync_resv(adev, &job->sync, vm->page_directory->tbo.resv,
+	r = amdgpu_sync_resv(adev, &job->sync, vm->root.bo->tbo.resv,
 			     owner);
 	if (r)
 		goto error_free;
 
-	r = reservation_object_reserve_shared(vm->page_directory->tbo.resv);
+	r = reservation_object_reserve_shared(vm->root.bo->tbo.resv);
 	if (r)
 		goto error_free;
 
@@ -1304,7 +1304,7 @@ fallback_sdma_update:
 	if (r)
 		goto error_free;
 
-	amdgpu_bo_fence(vm->page_directory, f, true);
+	amdgpu_bo_fence(vm->root.bo, f, true);
 	if (fence) {
 		fence_put(*fence);
 		*fence = fence_get(f);
@@ -1675,15 +1675,15 @@ int amdgpu_vm_bo_map(struct amdgpu_device *adev,
 
 	BUG_ON(eaddr >= amdgpu_vm_num_pdes(adev));
 
-	if (eaddr > vm->max_pde_used)
-		vm->max_pde_used = eaddr;
+	if (eaddr > vm->root.last_entry_used)
+		vm->root.last_entry_used = eaddr;
 
 	/* walk over the address space and allocate the page tables */
 	for (pt_idx = saddr; pt_idx <= eaddr; ++pt_idx) {
-		struct reservation_object *resv = vm->page_directory->tbo.resv;
+		struct reservation_object *resv = vm->root.bo->tbo.resv;
 		struct amdgpu_bo *pt;
 
-		if (vm->page_tables[pt_idx].bo)
+		if (vm->root.entries[pt_idx].bo)
 			continue;
 
 		r = amdgpu_bo_create(adev, AMDGPU_VM_PTE_COUNT * 8,
@@ -1706,10 +1706,10 @@ int amdgpu_vm_bo_map(struct amdgpu_device *adev,
 		/* Keep a reference to the page table to avoid freeing
 		 * them up in the wrong order.
 		 */
-		pt->parent = amdgpu_bo_ref(vm->page_directory);
+		pt->parent = amdgpu_bo_ref(vm->root.bo);
 
