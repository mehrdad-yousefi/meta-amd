 #if defined(CONFIG_HSA_AMD) || defined(CONFIG_HSA_AMD_MODULE)
 	vm->is_kfd_vm = is_kfd_vm;
@@ -1925,16 +1925,16 @@ int amdgpu_vm_init(struct amdgpu_device *adev, struct amdgpu_vm *vm,
 
